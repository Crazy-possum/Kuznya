  _name: "\u0421\u0442\u0430\u043B\u044C\u043D\u043E\u0439 \u0449\u0438\u0442"
  _descriptions:
  - _text: "\u0417\u043D\u0430\u0435\u0448\u044C, \u0433\u043E\u0432\u043E\u0440\u044F\u0442,
      \u0447\u0442\u043E \u0432 \u0434\u0440\u0435\u0432\u043D\u043E\u0441\u0442\u0438
      \u0438\u0441\u0442\u0438\u043D\u043D\u044B\u0435 \u0432\u043E\u0438\u043D\u044B
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u043B\u0438\u0441\u044C \u0441
      \u0432\u043E\u0439\u043D\u044B \u0441\u043E \u0449\u0438\u0442\u043E\u043C
      \u0438\u043B\u0438 \u043D\u0430 \u0449\u0438\u0442\u0435. \u0422\u043E\u043A
      \u0431\u043E\u044E\u0441\u044C \u043C\u043E\u0439 \u0449\u0438\u0442 \u043C\u0435\u043D\u044F
      \u043D\u0435 \u0432\u044B\u0434\u0435\u0440\u0436\u0438\u0442, \u0435\u0436\u043B\u0438
      \u0447\u0435, \u0445\u0435\u0445\u0435. \u0421\u043E\u0437\u0434\u0430\u0439
      \u043C\u043D\u0435 \u043D\u043E\u0432\u044B\u0439 \u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0439
      \u0449\u0438\u0442, \u0434\u0440\u0443\u0436\u0438\u0449\u0435"
    _description: "\u041D\u0443\u0436\u0435\u043D \u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0439
      \u0449\u0438\u0442"
