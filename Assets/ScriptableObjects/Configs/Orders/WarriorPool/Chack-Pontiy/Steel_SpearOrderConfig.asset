  _name: "\u0421\u0442\u0430\u043B\u044C\u043D\u043E\u0435 \u043A\u043E\u043F\u044C\u0435"
  _descriptions:
  - _text: "\u0417\u043D\u0430\u0435\u0448\u044C \u0437\u0430\u0447\u0435\u043C \u0438\u0441\u0442\u0438\u043D\u044B\u0439
      \u0432\u043E\u0438\u043D \u043D\u043E\u0441\u0438\u0442 \u0441 \u0441\u043E\u0431\u043E\u0439
      \u043A\u043E\u043F\u044C\u0435, \u0435\u0441\u043B\u0438 \u0443 \u043D\u0435\u0433\u043E
      \u0435\u0441\u0442\u044C \u043C\u0435\u0447? \u0427\u0442\u043E\u0431\u044B
      \u0441\u043D\u044F\u0442\u044C \u0432\u0440\u0430\u0433\u0430, \u043D\u0430\u0441\u0430\u0436\u0435\u043D\u043E\u0433\u043E
      \u043D\u0430 \u044D\u0442\u043E\u0442 \u043C\u0435\u0447! \u0425\u0430! \u041A\u043E\u043F\u044C\u0435
      \u043C\u043D\u0435 \u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0443\u0439,
      \u0442\u0432\u043E\u0440\u0447\u0435"
    _description: "\u041D\u0443\u0436\u043D\u043E \u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435
      \u043A\u043E\u043F\u044C\u0435"
