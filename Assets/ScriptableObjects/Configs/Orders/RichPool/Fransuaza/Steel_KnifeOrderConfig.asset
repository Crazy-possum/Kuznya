  _name: "\u0421\u0442\u0430\u043B\u044C\u043D\u043E\u0439 \u043D\u043E\u0436"
  _descriptions:
  - _text: "\u041C\u043E\u0439 \u0432\u0440\u0430\u0447\u0435\u0432\u0430\u0442\u0435\u043B\u044C
      \u0441\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u0437\u043D\u0430\u0442\u043D\u043E\u0439
      \u0434\u0435\u0432\u0438\u0446\u0435 \u043D\u0435 \u043F\u0440\u0438\u0441\u0442\u0430\u043B\u043E
      \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F \u043D\u043E\u0436\u043E\u043C
      \u043B\u0435\u043A\u0430\u0440\u044F \u0434\u043B\u044F \u043F\u0440\u043E\u0446\u0435\u0434\u0443\u0440\u044B
      \u043A\u0440\u043E\u0432\u043E\u043F\u0443\u0441\u043A\u0430\u043D\u0438\u044F.
      \u0418\u0437\u0433\u043E\u0442\u043E\u0432\u044C-\u043A\u0430 \u043C\u043D\u0435
      \u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0439 \u043D\u043E\u0436, \u0438
      \u043F\u043E\u0436\u0438\u0432\u0435\u0435"
    _description: "\u041A\u043B\u0438\u0435\u043D\u0442 \u043F\u0440\u043E\u0441\u0438\u0442
      \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0439
      \u043D\u043E\u0436"
