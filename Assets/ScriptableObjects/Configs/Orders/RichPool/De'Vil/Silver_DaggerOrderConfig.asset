  _name: "\u0421\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0439 \u043A\u0438\u043D\u0436\u0430\u043B"
  _descriptions:
  - _text: "\u0415\u0441\u0442\u044C \u0443 \u043C\u0435\u043D\u044F \u043E\u0434\u0438\u043D
      \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0439, \u0446\u0435\u043D\u0438\u0442\u0435\u043B\u044C
      \u0434\u0438\u043A\u043E\u0432\u0438\u043D\u043D\u043E\u0433\u043E, \u0435\u043C\u0443
      \u0431\u044B \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u043B\u0441\u044F
      \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0439 \u043A\u0438\u043D\u0436\u0430\u043B
      \u0434\u043B\u044F \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u0438"
    _description: "\u041A\u043B\u0438\u0435\u043D\u0442 \u043F\u0440\u043E\u0441\u0438\u0442
      \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0439
      \u043A\u0438\u043D\u0436\u0430\u043B"
