  _name: "\u0421\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u043E\u0435 \u043A\u043E\u043B\u0435\u0441\u043E"
  _descriptions:
  - _text: "\u041D\u0435\u043D\u0430\u0432\u0438\u0436\u0443 \u043C\u0435\u0441\u0442\u043D\u044B\u0435
      \u0434\u043E\u0440\u043E\u0433\u0438, \u043D\u0443 \u043D\u0435\u0443\u0436\u0435\u043B\u0438
      \u043D\u0435\u043B\u044C\u0437\u044F \u0445\u043E\u0442\u044C \u0438\u043D\u043E\u0433\u0434\u0430
      \u0438\u0445 \u043E\u0431\u043D\u043E\u0432\u043B\u044F\u0442\u044C? \u041F\u043E\u0441\u043B\u0435
      \u043D\u0438\u0445 \u043C\u043D\u0435 \u0441\u0440\u043E\u0447\u043D\u043E
      \u043D\u0430\u0434\u043E \u043D\u043E\u0432\u043E\u0435 \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u043E\u0435
      \u043A\u043E\u043B\u0435\u0441\u043E!"
    _description: "\u041D\u0443\u0436\u043D\u043E \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u043E\u0435
