  _name: "\u041C\u0435\u0434\u043D\u044B\u0439 \u043A\u0438\u043D\u0436\u0430\u043B"
  _descriptions:
  - _text: "\u0414\u043E\u0447\u0435\u043D\u044C\u043A\u0430 \u043C\u043E\u044F \u043D\u0430\u0441\u0442\u0430\u0438\u0432\u0430\u0435\u0442
