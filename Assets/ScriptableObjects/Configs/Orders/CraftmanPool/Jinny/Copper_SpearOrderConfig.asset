  _name: "\u041C\u0435\u0434\u043D\u043E\u0435 \u043A\u043E\u043F\u044C\u0435"
  _descriptions:
  - _text: "\u0422\u043E\u043B\u044C\u043A\u043E \u0437\u0430\u0445\u043E\u0436\u0443
      \u0441\u044E\u0434\u0430 - \u0443\u0436\u0435 \u043E\u0442 \u0441\u0442\u0443\u043A\u0430
      \u0433\u043E\u043B\u043E\u0432\u0430 \u0431\u043E\u043B\u0438\u0442. \u0414\u0430
      \u0441\u044B\u043D\u043E\u0447\u043A\u0435-\u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0443
      \u0431\u044B \u043C\u0435\u0434\u043D\u043E\u0435 \u043A\u043E\u043F\u044C\u0435
      \u043D\u0430\u0434\u043E\u0431\u043D\u043E, \u0441\u0434\u0435\u043B\u0430\u0439\u0442\u0435
      \u043F\u043E\u0431\u044B\u0441\u0442\u0440\u0435\u0435, \u043D\u0435 \u0445\u043E\u0447\u0443
      \u0437\u0434\u0435\u0441\u044C \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C\u0441\u044F!"
    _description: "\u041D\u0443\u0436\u043D\u043E \u043C\u0435\u0434\u043D\u043E\u0435
      \u043A\u043E\u043F\u044C\u0435"
