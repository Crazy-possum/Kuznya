  _name: "\u041C\u0435\u0434\u043D\u043E\u0435 \u043A\u043E\u043F\u044C\u0435"
  _descriptions:
  - _text: "\u041C\u0430\u0441\u0442\u0435\u0440 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B
      \u043C\u0435\u043D\u044F \u0437\u0430 \u043C\u0435\u0434\u043D\u044B\u043C
      \u043A\u043E\u043F\u044C\u0435\u043C \u0434\u043B\u044F \u0441\u044B\u043D\u0438\u0448\u043A\u0438
      \u0435\u0433\u043E. \u0413\u043E\u0432\u043E\u0440\u0438\u0442, \u043D\u0435
      \u0432\u043E\u0437\u044C\u043C\u0435\u0442 \u0441 \u0440\u0430\u043D\u043D\u0438\u0445
      \u043B\u0435\u0442 \u043E\u0440\u0443\u0436\u0438\u0435 \u0432 \u0440\u0443\u043A\u0438
      - \u043C\u0443\u0436\u0438\u043A\u043E\u043C \u043D\u0435 \u0441\u0442\u0430\u043D\u0435\u0442.
      \u041D\u0443 \u0432\u044B \u043F\u043E\u0434\u0443\u043C\u0430\u0439\u0442\u0435
      \u0442\u043E\u043B\u044C\u043A\u043E, \u0435\u043C\u0443 \u0432\u0441\u0435\u0433\u043E
      3 \u0432\u0435\u0441\u043D\u044B \u043F\u0440\u043E\u0448\u043B\u043E... \u0421\u0434\u0435\u043B\u0430\u0439\u0442\u0435
      \u043F\u043E\u043C\u0435\u043D\u044C\u0448\u0435 \u0435\u0433\u043E, \u0434\u0430
      \u0437\u0430\u0442\u043E\u0447\u0438\u0442\u0435 \u043F\u043E\u0441\u043B\u0430\u0431\u0436\u0435"
    _description: "\u041A\u043B\u0438\u0435\u043D\u0442 \u043F\u0440\u043E\u0441\u0438\u0442
      \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u043C\u0435\u0434\u043D\u043E\u0435
      \u043A\u043E\u043F\u044C\u0435"
