  _name: "\u041C\u0435\u0434\u043D\u044B\u0439 \u0442\u043E\u043F\u043E\u0440"
  _descriptions:
  - _text: "\u0421\u044B\u043D\u043E\u043A, \u043C\u043D\u0435 \u0431\u044B \u0442\u043E\u043F\u043E\u0440\u0438\u0448\u043A\u043E
      \u043D\u043E\u0432\u044B\u0439. \u0421\u0442\u0430\u0440\u044B\u0439 \u043C\u043E\u0439
      \u043A\u043E\u0431\u044B\u043B\u0430 \u0432 \u043A\u043E\u043B\u043E\u0434\u0435\u0446
      \u0432\u044B\u043A\u0438\u043D\u0443\u043B\u0430, \u043A\u043E\u0433\u0434\u0430
      \u0441\u0435\u043D\u043E \u0432\u043E\u0440\u043E\u0448\u0438\u043B\u0430.
      \u0421\u043C\u0430\u0441\u0442\u0435\u0440\u0438 \u043C\u0435\u0434\u043D\u044B\u0439,
      \u0434\u0430 \u043F\u043E\u043B\u0435\u0433\u0447\u0435 \u0434\u043B\u044F
      \u0441\u0442\u0430\u0440\u0438\u043A\u0430, \u0440\u0443\u043A\u0438 \u043D\u0435
      \u0442\u0435 \u0443\u0436\u0435"
    _description: "\u041D\u0443\u0436\u0435\u043D \u043C\u0435\u0434\u043D\u044B\u0439
      \u0442\u043E\u043F\u043E\u0440"
