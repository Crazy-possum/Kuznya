  _name: "\u041C\u0435\u0434\u043D\u044B\u0439 \u043A\u0438\u043D\u0436\u0430\u043B"
  _descriptions:
  - _text: "\u0425\u043E\u0447\u0443 \u0441\u044B\u043D\u0443 \u043F\u043E \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044E
      \u0441 \u043F\u043E\u0445\u043E\u0434\u0430 \u0441\u0434\u0435\u043B\u0430\u0442\u044C
      \u043F\u043E\u0434\u0430\u0440\u043E\u043A \u043D\u0430 \u043F\u0430\u043C\u044F\u0442\u044C,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0430 \u0432\u043E\u0439\u043D\u0435
      \u043D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u043B \u043E \u0441\u0442\u0430\u0440\u0438\u043A\u0435.
      \u0421\u0434\u0435\u043B\u0430\u0439 \u043C\u0435\u0434\u043D\u044B\u0439 \u043A\u0438\u043D\u0436\u0430\u043B,
      \u0447\u0442\u043E\u0431 \u043E\u0442 \u0434\u0443\u0448\u0438 \u0431\u044B\u043B
      \u043F\u0440\u044F\u043C, \u044F \u043D\u0435 \u043F\u043E\u0441\u043A\u0443\u043F\u043B\u044E\u0441\u044C
      \u043E\u0442\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C"
    _description: "\u041D\u0443\u0436\u0435\u043D \u043C\u0435\u0434\u043D\u044B\u0439
      \u043A\u0438\u043D\u0436\u0430\u043B"
