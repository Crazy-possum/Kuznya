  _name: "\u041C\u0435\u0434\u043D\u043E\u0435 \u043A\u043E\u043B\u0435\u0441\u043E"
  _descriptions:
  - _text: "\u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u0445\u043E\u0447\u0435\u0442
      \u0432\u043E\u0437\u0438\u0442\u044C \u0442\u043E\u0432\u0430\u0440 \u043F\u043E
      \u0442\u0440\u0430\u043A\u0442\u0443, \u0432\u043E\u0442 \u0438 \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u043A\u0443\u043F\u0438\u0442\u044C \u0442\u0435\u043B\u0435\u0433\u0443 -
      \u0434\u0430 \u043C\u0435\u0434\u043D\u043E\u0433\u043E \u043A\u043E\u043B\u0435\u0441\u0430
      \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u043A\u0430\u043A
      \u043D\u0430 \u0437\u043B\u043E - \u0441\u043B\u043E\u043C\u0430\u043B\u043E\u0441\u044C
      \u0432 \u043F\u0435\u0440\u0432\u0443\u044E \u0436\u0435 \u043F\u043E\u0435\u0437\u0434\u043A\u0443.
      \u0421\u043A\u0443\u0435\u0448\u044C?"
    _description: "\u041A\u043B\u0438\u0435\u043D\u0442 \u043F\u0440\u043E\u0441\u0438\u0442
      \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u043C\u0435\u0434\u043D\u043E\u0435
      \u043A\u043E\u043B\u0435\u0441\u043E"
