  _name: "\u0413\u0440\u0443\u0431\u044B\u0439 \u043A\u0438\u043D\u0436\u0430\u043B"
  _descriptions:
  - _text: "\u041C\u043E\u0439 \u0441\u0442\u0430\u0440\u0438\u043A \u0441\u043A\u0430\u0437\u0430\u043B,
      \u0447\u0442\u043E \u0443 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0443\u0432\u0430\u0436\u0430\u044E\u0449\u0435\u0433\u043E
      \u0441\u0435\u0431\u044F \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0434\u043E\u043B\u0436\u0435\u043D
      \u0431\u044B\u0442\u044C \u043A\u0438\u043D\u0436\u0430\u043B \u0437\u0430
      \u043F\u0430\u0437\u0443\u0445\u043E\u0439, \u043D\u0430 \u0441\u043B\u0443\u0447\u0430\u0439
      \u043D\u0443\u0436\u0434\u044B. \u041D\u0443 \u044F \u0441\u0435\u0431\u044F
      \u0443\u0432\u0430\u0436\u0430\u044E! \u0414\u0430\u0436\u0435 \u043A\u0430\u0440\u043C\u0430\u043D
      \u0443\u0436\u0435 \u043F\u0440\u0438\u0448\u0438\u043B. \u0414\u0430\u0439
      \u043C\u043D\u0435 \u0433\u0440\u0443\u0431\u044B\u0439 \u043A\u0438\u043D\u0436\u0430\u043B"
    _description: "\u041D\u0443\u0436\u0435\u043D \u0433\u0440\u0443\u0431\u044B\u0439
      \u043A\u0438\u043D\u0436\u0430\u043B"
