  _name: "\u0413\u0440\u0443\u0431\u044B\u0439 \u043A\u0438\u043D\u0436\u0430\u043B"
  _descriptions:
  - _text: "\u041D\u0443 \u0430 \u0447\u0442\u043E? \u041D\u0443\u0436\u043D\u043E
      \u0436\u0435 \u0441\u0442\u0430\u0440\u043E\u043C\u0443 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0443
      \u043A\u0430\u043A-\u0442\u043E \u0441\u0435\u0431\u044F \u0437\u0430\u0449\u0438\u0449\u0430\u0442\u044C,
      \u043F\u043E\u043A\u0430 \u043E\u0442 \u0441\u0435\u043B\u0430 \u043D\u0430\u0448\u0435\u0433\u043E
      \u0434\u043E \u0433\u043E\u0440\u043E\u0434\u0430 \u0438\u0434\u0443. \u0421\u0434\u0435\u043B\u0430\u0439
      \u043C\u043D\u0435 \u043A\u0438\u043D\u0436\u0430\u043B \u0433\u0440\u0443\u0431\u044B\u0439,
      \u0434\u0430 \u043F\u043E\u043A\u0440\u0435\u043F\u0447\u0435!"
    _description: "\u041A\u043B\u0438\u0435\u043D\u0442 \u043F\u0440\u043E\u0441\u0438\u0442
      \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u0433\u0440\u0443\u0431\u044B\u0439
      \u043A\u0438\u043D\u0436\u0430\u043B"
