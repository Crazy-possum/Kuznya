  _name: "\u0413\u0440\u0443\u0431\u044B\u0439 \u0441\u0435\u0440\u043F"
  _descriptions:
  - _text: "\u0427\u0442\u043E \u0432 \u0443\u0440\u043E\u0436\u0430\u0439\u043D\u044B\u0439
      \u0441\u0435\u0437\u043E\u043D \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C
      \u0445\u0443\u0436\u0435 \u0438\u0441\u043F\u043E\u0440\u0447\u0435\u043D\u043D\u043E\u0433\u043E
      \u0441\u0435\u0440\u043F\u0430? \u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E:
      \u0438\u0441\u043F\u043E\u0440\u0447\u0435\u043D\u043D\u044B\u0439 \u0443\u0440\u043E\u0436\u0430\u0439.
      \u041D\u043E \u0441\u0435\u0440\u043F \u0442\u044B \u043C\u043D\u0435 \u0432\u0441\u0435
      \u0440\u0430\u0432\u043D\u043E \u0441\u0434\u0435\u043B\u0430\u0439, \u0433\u0440\u0443\u0431\u044B\u0439,
      \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439"
    _description: "\u041A\u043B\u0438\u0435\u043D\u0442 \u043F\u0440\u043E\u0441\u0438\u0442
      \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u0433\u0440\u0443\u0431\u044B\u0439
      \u0441\u0435\u0440\u043F"
