  _name: "\u0416\u0435\u043B\u0435\u0437\u043D\u044B\u0439 \u043C\u0435\u0447"
  _descriptions:
  - _text: "\u041F\u043E\u0440\u0430\u0436\u0430\u044E\u0441\u044C \u0432\u0430\u0448\u0435\u043C\u0443
      \u0440\u043E\u0434\u0443 \u043A\u0443\u0437\u043D\u0435\u0446\u043A\u043E\u043C\u0443,\u0442\u0430\u043A\u043E\u0439
      \u0442\u0440\u0443\u0434... \u041C\u0430\u0441\u0442\u0435\u0440, \u0441\u043A\u0443\u0439\u0442\u0435
      \u043C\u043D\u0435 \u0436\u0435\u043B\u0435\u0437\u043D\u044B\u0439 \u043C\u0435\u0447,
      \u043A\u0430\u0431 \u0413\u043E\u0441\u043F\u043E\u0434\u044C \u0431\u044B\u043B
      \u043D\u0430 \u0432\u0430\u0448\u0435\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u0435
      \u0443\u0441\u0435\u0434\u044B"
    _description: "\u041D\u0443\u0436\u0435\u043D \u0436\u0435\u043B\u0435\u0437\u043D\u044B\u0439
      \u043C\u0435\u0447"
