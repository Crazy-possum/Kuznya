  _name: "\u041C\u0435\u0434\u043D\u043E\u0435 \u043A\u043E\u043B\u0435\u0441\u043E"
  _descriptions:
  - _text: "\u041C\u043D\u043E\u0433\u0438\u0435 \u0433\u043E\u0432\u043E\u0440\u044F\u0442,
      \u0447\u0442\u043E \u0434\u043E\u0440\u043E\u0433\u0438 \u0442\u0440\u0430\u043A\u0442\u0430
      \u043F\u043B\u043E\u0445\u0438. \u0411\u043E\u044E\u0441\u044C \u0437\u0430
      \u0441\u0432\u043E\u044E \u0441\u0442\u0430\u0440\u0443\u044E \u043A\u043B\u044F\u0447\u0443
      \u0438 \u0442\u0435\u043B\u0435\u0433\u0443 - \u043C\u043D\u0435 \u0431 \u043C\u0435\u0434\u043D\u043E\u0435
      \u043A\u043E\u043B\u0435\u0441\u043E \u0437\u0430\u043C\u0435\u043D\u0438\u0442\u044C,
      \u0441\u0434\u0435\u043B\u0430\u0435\u0442\u0435?"
    _description: "\u041A\u043B\u0438\u0435\u043D\u0442 \u043F\u0440\u043E\u0441\u0438\u0442
      \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u043C\u0435\u0434\u043D\u043E\u0435
      \u043A\u043E\u043B\u0435\u0441\u043E"
