  _name: "\u041C\u0435\u0434\u043D\u044B\u0439 \u043C\u0435\u0447"
  _descriptions:
  - _text: "\u041C\u0435\u043D\u044F \u043D\u0435\u0434\u0430\u0432\u043D\u043E \u043F\u0440\u0438\u043D\u044F\u043B\u0438
      \u0432 \u043E\u0440\u0443\u0436\u0435\u043D\u043E\u0441\u0446\u044B \u043F\u0440\u0438
      \u0434\u0432\u043E\u0440\u0446\u043E\u0432\u043E\u043C \u0440\u044B\u0446\u0430\u0440\u0435,
      \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442\u0435?
      \u0414\u0430 \u0432\u043E\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u0435\u043D\u0435\u0433
      \u0443 \u043C\u0435\u043D\u044F \u043D\u0435 \u0432\u043E\u0434\u0438\u0442\u0441\u044F,
      \u0430 \u043C\u0435\u0434\u043D\u044B\u0439 \u043C\u0435\u0447 \u0445\u043E\u0447\u0435\u0442\u0441\u044F!"
    _description: "\u041A\u043B\u0438\u0435\u043D\u0442 \u043F\u0440\u043E\u0441\u0438\u0442
      \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u043C\u0435\u0434\u043D\u044B\u0439
      \u043C\u0435\u0447"
