  - _text: "\u0421\u043A\u043E\u0432\u043E\u0440\u043E\u0434\u043A\u0443 \u0437\u0430\u043F\u0438\u043B\u0438"
    _description: "\u041D\u0443\u0436\u043D\u043E \u0437\u0430\u043F\u0438\u043B\u0438\u0442\u044C
      \u043C\u0435\u0434\u043D\u0443\u044E \u0441\u043A\u043E\u0432\u043E\u0440\u043E\u0434\u043A\u0443,
