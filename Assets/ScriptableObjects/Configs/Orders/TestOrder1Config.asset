  _name: "\u041C\u0435\u0434\u043D\u0430\u044F \u0441\u043A\u043E\u0432\u043E\u0440\u043E\u0434\u043A\u0430"
  _descriptions:
  - _text: "\u0421\u043A\u0440\u0430\u0444\u0442\u0438 \u0441\u043A\u043E\u0432\u043E\u0440\u043E\u0434\u043A\u0443"
    _description: "\u041D\u0443\u0436\u043D\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C
