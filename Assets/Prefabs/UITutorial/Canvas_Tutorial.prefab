      m_Calls: []
  m_text: "\u041F\u043E\u0445\u043E\u0436\u0435, \u0447\u0442\u043E \u0441\u0435\u0439\u0447\u0430\u0441
    \u0432\u0430\u043C \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0434\u0435\u043D\u0435\u0433
    \u043D\u0438 \u043D\u0430 \u043E\u0434\u043D\u043E \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435.
    \u041D\u043E \u0442\u0435\u043F\u0435\u0440\u044C, \u043A\u043E\u0433\u0434\u0430
    \u0432\u044B \u0437\u043D\u0430\u0435\u0442\u0435 \u043E\u0441\u043D\u043E\u0432\u044B,
    \u0432\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
    \u0438\u0445 \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E!
    \u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0442\u0435\u0441\u044C
    \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D, \u043A\u043E\u0433\u0434\u0430
    \u043D\u0430\u043A\u043E\u043F\u0438\u0442\u0435 1500 \u043C\u043E\u043D\u0435\u0442"
