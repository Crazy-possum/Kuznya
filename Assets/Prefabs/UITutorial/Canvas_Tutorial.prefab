  m_text: "\u0417\u0430 \u0440\u0430\u0437 \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435
    \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E
    \u043E\u0434\u0438\u043D \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B. \u041E\u043D
    \u0432\u044B\u0434\u0435\u043B\u0435\u043D \u0437\u0435\u043B\u0435\u043D\u044B\u043C
    \u0446\u0432\u0435\u0442\u043E\u043C. \u0427\u0442\u043E\u0431\u044B \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0438\u0442\u044C\u0441\u044F
    \u043D\u0430 \u0434\u0440\u0443\u0433\u043E\u0439 \u0440\u0435\u0441\u0443\u0440\u0441
    - \u043A\u043B\u0438\u043A\u043D\u0438\u0442\u0435 \u043F\u043E \u0435\u0433\u043E
    \u0438\u043A\u043E\u043D\u043A\u0435 \u0432\u043D\u0438\u0437\u0443 \u044D\u043A\u0440\u0430\u043D\u0430"
