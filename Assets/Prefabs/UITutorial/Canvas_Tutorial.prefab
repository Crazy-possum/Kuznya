  m_text: "\u0412 \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0438 \u0437\u0430\u043A\u0430\u0437\u0430
    \u0443\u043A\u0430\u0437\u0430\u043D\u043E \u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0438 \u043A\u0430\u043A\u043E\u0433\u043E \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430
    \u0432\u0430\u043C \u043D\u0443\u0436\u043D\u043E \u0434\u043B\u044F \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F.
    \u041A\u043E\u0433\u0434\u0430 \u043D\u0430\u043A\u043E\u043F\u0438\u0442\u0441\u044F
    \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    - \u0432\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u0438\u0442\u044C
    \u043A \u043A\u043E\u0432\u043A\u0435. \u042D\u0442\u0438 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B
    \u0431\u0443\u0434\u0443\u0442 \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u044B
    \u043D\u0430 \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u0435"
  m_isRightToLeft: 0
