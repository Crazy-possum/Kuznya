  m_text: "\u041D\u0430\u0431\u0440\u0430\u043D\u043D\u044B\u0439 \u0436\u0430\u0440
    \u0434\u0430\u0441\u0442 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
