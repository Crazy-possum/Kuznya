    \u0446\u0435\u043D\u0443 \u0437\u0430 \u0437\u0430\u043A\u0430\u0437. \u041D\u043E
    \u0435\u0441\u043B\u0438 \u043A\u043B\u0438\u0435\u043D\u0442 \u043E\u043A\u0430\u0436\u0435\u0442\u0441\u044F
    \u0443\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u0435\u0435 - \u043E\u043D
    \u0432\u044B\u0442\u043E\u0440\u0433\u0443\u0435\u0442 \u0441\u043A\u0438\u0434\u043A\u0443"
