  m_text: "\u0414\u043B\u044F \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0439
    \u0437\u0430\u043A\u0430\u043B\u043A\u0435 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
    \u201C\u043F\u0443\u0433\u0430\u0442\u044C\u201D \u043C\u0435\u0442\u0430\u043B\u043B
    \u0440\u0430\u0432\u043D\u043E\u043C\u0435\u0440\u043D\u043E. \u0415\u0441\u043B\u0438
    \u043C\u0430\u0441\u043B\u043E \u043F\u0443\u0437\u044B\u0440\u0438\u0442\u0441\u044F
    - \u0432\u0441\u0435 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E,
    \u0435\u0441\u043B\u0438 \u043D\u0435\u0442 - \u0434\u0432\u0438\u0433\u0430\u0439\u0442\u0435
    \u043F\u043E\u043B\u0437\u0443\u043D\u043E\u043A \u0438 \u0438\u0449\u0438\u0442\u0435
    \u043D\u0443\u0436\u043D\u0443\u044E \u0433\u043B\u0443\u0431\u0438\u043D\u0443"
