  m_text: "\u0412\u044B \u043E\u0442\u043A\u0440\u044B\u043B\u0438 \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u044E!
    \u0422\u0435\u043F\u0435\u0440\u044C \u043F\u0435\u0440\u0435\u0434 \u0441\u0434\u0430\u0447\u0435\u0439
