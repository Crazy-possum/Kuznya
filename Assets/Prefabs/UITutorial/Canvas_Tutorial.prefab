  m_text: "\u041A\u043E\u0433\u0434\u0430 \u0432\u044B \u0438\u0437\u0433\u043E\u0442\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0435
    \u0437\u0430\u043A\u0430\u0437 \u0435\u0433\u043E \u0441\u0442\u0430\u0442\u0443\u0441
    \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u043D\u0430 \u201C\u0433\u043E\u0442\u043E\u0432\u201D.
    \u041A\u043B\u0438\u043A\u043D\u0443\u0432 \u043F\u043E \u0437\u0430\u043A\u0430\u0437\u0443
    \u043C\u043E\u0436\u043D\u043E \u0441\u0434\u0430\u0442\u044C \u0435\u0433\u043E
    \u043A\u043B\u0438\u0435\u043D\u0442\u0443. \u041E\u0431\u0440\u0430\u0442\u0438\u0442\u0435
    \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435, \u0447\u0442\u043E \u043D\u0430
    \u043D\u0435\u0433\u043E\u0442\u043E\u0432\u044B\u0445 \u0437\u0430\u043A\u0430\u0437\u0430\u0445
    \u0441\u0442\u043E\u0438\u0442 \u043A\u0440\u0430\u0441\u043D\u0430\u044F \u043F\u0435\u0447\u0430\u0442\u044C,
    \u0430 \u043D\u0430 \u0433\u043E\u0442\u043E\u0432\u044B\u0445 \u0437\u0435\u043B\u0435\u043D\u0430\u044F"
