  m_text: "\u0427\u0442\u043E\u0431\u044B \u0443\u0431\u0435\u0434\u0438\u0442\u044C
    \u043A\u043B\u0438\u0435\u043D\u0442\u0430 \u043F\u0435\u0440\u0435\u043F\u043B\u0430\u0442\u0438\u0442\u044C
    \u0432\u0430\u043C \u043D\u0443\u0436\u043D\u043E \u0443\u0434\u0435\u0440\u0436\u0430\u0442\u044C
    \u0438\u043A\u043E\u043D\u043A\u0443 \u0432 \u0437\u0435\u043B\u0435\u043D\u043E\u0439
    \u0437\u043E\u043D\u0435. \u041A\u043B\u0438\u043A\u0430\u0439\u0442\u0435 \u043F\u043E
    \u0448\u043A\u0430\u043B\u0435, \u0447\u0442\u043E\u0431\u044B \u0434\u0432\u0438\u0433\u0430\u0442\u044C
    \u0438\u043A\u043E\u043D\u043A\u0443. \u0411\u0443\u0434\u044C\u0442\u0435 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u0435\u0435:
    \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435 \u0432 \u0436\u0435\u043B\u0442\u044B\u0435
    \u0438 \u043A\u0440\u0430\u0441\u043D\u044B\u0435 \u0437\u043E\u043D\u044B \u043E\u0431\u0438\u0434\u0438\u0442
    \u043A\u043B\u0438\u0435\u043D\u0442\u0430 \u0438 \u043E\u043D \u043D\u0430\u0447\u043D\u0435\u0442
    \u0432\u044B\u0431\u0438\u0432\u0430\u0442\u044C \u0441\u043A\u0438\u0434\u043A\u0443"
