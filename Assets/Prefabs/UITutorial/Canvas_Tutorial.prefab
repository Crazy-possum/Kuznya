  m_text: "\u0422\u0435\u043F\u0435\u0440\u044C \u0432\u044B \u0431\u0443\u0434\u0435\u0442\u0435
    \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u044C \u041E\u043B\u043E\u0432\u043E
    \u0432\u043C\u0435\u0441\u0442\u043E \u041D\u0435\u043E\u0431\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u043E\u0433\u043E
    \u043C\u0435\u0442\u0430\u043B\u043B\u0430. \u0415\u0441\u043B\u0438 \u0437\u0430\u0445\u043E\u0442\u0438\u0442\u0435
    \u0441\u043D\u043E\u0432\u0430 \u043D\u0430\u043A\u043E\u043F\u0438\u0442\u044C
    \u043C\u0435\u0442\u0430\u043B\u043B - \u0432\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C
    \u0441\u044E\u0434\u0430 \u0438 \u043F\u043E\u043C\u0435\u043D\u044F\u0439\u0442\u0435
    \u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0439 \u0440\u0435\u0441\u0443\u0440\u0441.
    \u0422\u0435\u043F\u0435\u0440\u044C \u0432\u0435\u0440\u043D\u0435\u043C\u0441\u044F
