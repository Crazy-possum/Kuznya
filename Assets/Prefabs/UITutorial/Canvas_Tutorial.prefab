  m_text: "\u0417\u0434\u0435\u0441\u044C \u0436\u0435 \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435
    \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0443 \u0432\u0430\u0441 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
    \u043D\u0430 \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u0435.
    \u041A\u043E\u0433\u0434\u0430 \u0448\u043A\u0430\u043B\u0430 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
    \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0441\u044F - \u043A\u043B\u0438\u0435\u043D\u0442
    \u043E\u0442\u0437\u043E\u0432\u0435\u0442 \u0441\u0432\u043E\u0439 \u0437\u0430\u043A\u0430\u0437.
    \u041F\u0440\u0438 \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u0438
    \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
    \u0442\u0430\u0439\u043C\u0435\u0440 \u0432 \u043F\u0440\u0430\u0432\u043E\u043C
    \u0432\u0435\u0440\u0445\u043D\u0435\u043C \u0443\u0433\u043B\u0443 \u044D\u043A\u0440\u0430\u043D\u0430"
