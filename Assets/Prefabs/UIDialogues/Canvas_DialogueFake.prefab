  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0427\u0442\u043E \u0436... \u043C\u043E\u0439 \u0434\u0432\u043E\u0440
    \u0441\u043B\u0430\u0432\u0438\u0442\u0441\u044F \u0441\u0432\u043E\u0435\u0439
    \u043C\u0438\u043B\u043E\u0441\u0442\u044C\u044E... \u0414\u0443\u043C\u0430\u044E
    \u044F \u043C\u043E\u0433\u0443 \u0434\u0430\u0442\u044C \u0442\u0435\u0431\u0435
    \u0448\u0430\u043D\u0441 - \u0437\u0430\u043F\u043B\u0430\u0442\u0438 \u043D\u0430\u043B\u043E\u0433
    \u0438 \u043F\u043B\u0430\u0442\u0438 \u0435\u0433\u043E \u0438\u0441\u043F\u0440\u0430\u0432\u043D\u043E
    \u043F\u043E\u043A\u0430 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u0442\u0432\u043E\u044F
    \u043A\u0443\u0437\u043D\u044F, \u043A\u043E\u043D\u0435\u0447\u043D\u043E \u0436\u0435
    \u0441 \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u0430\u043C\u0438     \n\u041F\u043E\u043A\u0430
    \u0434\u0435\u043D\u044C\u0433\u0438 \u0431\u0443\u0434\u0443\u0442 \u043F\u043E\u0441\u0442\u0443\u043F\u0430\u0442\u044C
    \u0432 \u043A\u043E\u0437\u043D\u0443 - \u044F \u043D\u0435 \u0442\u0440\u043E\u043D\u0443
    \u0442\u0432\u043E\u044E \u043B\u0430\u0447\u0443\u0433\u0443. \u0420\u0435\u0448\u0430\u0439
    \u0441\u0435\u0439\u0447\u0430\u0441 \u0438\u043B\u0438 \u044F \u0432\u0432\u0435\u0434\u0443
    \u043C\u043E\u0438\u0445 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u043E\u0432!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: f9f91fc13fb1d504cb04bab3da031f1e, type: 2}
